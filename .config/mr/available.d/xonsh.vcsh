[$HOME/.config/vcsh/repo.d/xonsh.git]
order = 10
# NOTE: put the correct url for your repository
checkout = vcsh clone -b xonsh https://github.com/DNajjarzade/vcsh_mr_template.git xonsh && \
           vcsh xonsh branch --set-upstream-to=origin/xonsh xonsh
           vcsh xonsh checkout -b ${user}_$(hostname) && \ 
           vcsh xonsh remote set-url --push origin  git@github.com:DNajjarzade/vcsh_mr_template.git && \ 
           vcsh xonsh push --set-upstream origin ${user}_$(hostname) 