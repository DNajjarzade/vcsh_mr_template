[$HOME/.config/vcsh/repo.d/secret.git]
order = 10
# NOTE: put the correct url for your repository
checkout =
  VCSH_BASE="$HOME/" \
  vcsh clone -b secret https://github.com/DNajjarzade/vcsh_mr_template.git secret &&
           vcsh secret branch --set-upstream-to=origin/secret secret
           vcsh secret checkout -b ${user}_$(hostname) && \ 
           vcsh secret push --set-upstream origin ${user}_$(hostname)