[$HOME/.config/vcsh/repo.d/mr.git]
checkout = vcsh clone -b mr https://github.com/DNajjarzade/vcsh_mr_template mr && \
           vcsh mr branch --set-upstream-to=origin/mr mr && \
           vcsh mr checkout -b "$(whoami)@$(hostname)" && \ 
           vcsh mr remote set-url --push origin git@github.com:DNajjarzade/vcsh_mr_template.git && \
           vcsh mr push --set-upstream origin "$(whoami)@$(hostname)"
